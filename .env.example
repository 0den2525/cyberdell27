# G0DM0D3 Environment Variables
# Copy this file to .env and fill in your values.
# See CONTRIBUTING.md for setup instructions.

# ─── Model Provider API Keys ───────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: Venice AI key (https://venice.ai)
VENICE_API_KEY=

# Optional: Direct OpenAI key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# ─── Telemetry / Hugging Face (optional) ──────────────────────────
# Only needed if you want to publish telemetry data to HF
HF_TOKEN=
HF_DATASET_REPO=

# ─── Server Configuration ─────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS (optional) ──────────────────────────────────────────────
# Comma-separated list of allowed origins for the API server
CORS_ORIGINS=http://localhost:3000,http://localhost:8000